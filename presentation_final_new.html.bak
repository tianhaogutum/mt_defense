olid #b1cbdc}.mapping-row{padding:26px 0;border-bottom:1px solid var(--line);font-size:22px}.mapping-row>strong{font-size:22px}.mapping-row>span{font-size:23px;color:var(--blue);font-weight:700;line-height:1.35}.mapping-row small{font-size:16px;font-weight:400;color:var(--muted)}.mapping-row p{font-size:20px}.cluefl-definition{display:flex;gap:24px;align-items:center;margin-top:4px}.cluefl-definition strong{font-size:38px;color:var(--blue);letter-spacing:-1px}.cluefl-definition p{font-size:16px}.framework-figure img{max-height:372px}.phase-labels{display:flex;justify-content:center;gap:64px;margin-top:5px;font-size:17px}.phase-labels b{color:var(--blue);margin-right:12px}.gain-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.gain-grid>div{border-left:3px solid var(--blue);padding-left:23px}.gain-grid strong{display:block;font-size:56px;line-height:1.1;color:var(--blue);letter-spacing:-2px;margin:10px 0}.gain-grid small{font-size:26px;letter-spacing:0}.gain-grid p{font-size:20px}.gain-grid p span{font-size:15px;margin-left:20px;color:#788b9b}.cluefl-table img{max-height:236px}.contribution-list{display:flex;flex-direction:column}.contribution-list article{display:flex;gap:30px;align-items:center;padding:29px 0;border-bottom:1px solid var(--line)}.contribution-list article:last-child{border-bottom:0}.contribution-list article>span{font-size:52px;font-weight:700;letter-spacing:-2px;color:#98b8d0;width:80px}.contribution-list h2{font-size:30px;margin-bottom:11px}.contribution-list p{font-size:19px;max-width:880px}.contribution-list article>b{margin-left:auto;font-size:14px;color:var(--blue);width:94px;text-align:right}.closing-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:100px;align-items:center}.closing-message h2{font-size:72px;line-height:1.04;letter-spacing:-2px;margin:25px 0}.closing-message h2 span{color:var(--blue)}.closing-message p{font-size:20px}.text-button{border:0;background:none;color:var(--blue);padding:0;font-size:16px;margin-top:30px}.text-button:hover{text-decoration:underline}.limits>.label{margin-bottom:20px}.limits>div{padding:17px 0;border-top:1px solid var(--line)}.limits strong{font-size:22px}.limits p{font-size:18px;margin-top:7px}.backup-method img{max-height:495px}.ablation-table img{max-height:346px}
.app-footer{height:66px;display:flex;justify-content:space-between;align-items:center;padding:0 30px;gap:20px;background:var(--bg-soft-3);border-top:1px solid var(--border-soft)}.chapters{display:flex;gap:22px;align-items:center}.chapter-button{background:none;border:0;border-top:2px solid transparent;padding:10px 0;font-size:11px;color:#71818e;letter-spacing:.3px;white-space:nowrap}.chapter-button.active{border-color:var(--blue);color:var(--blue);font-weight:700}.nav-controls{display:flex;align-items:center;gap:12px}.page-count{font-size:12px;font-variant-numeric:tabular-nums;color:#748492;min-width:67px;text-align:center}.page-count strong{color:var(--ink);font-size:15px}.nav-arrow{border:1px solid #d4dee7;border-radius:50%;width:34px;height:34px;background:white;display:grid;place-items:center}.nav-arrow:hover:not(:disabled){background:var(--pale);color:var(--blue)}.global-progress{position:fixed;bottom:0;left:0;height:2px;background:var(--blue);width:0;transition:width .15s}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.notes-panel{position:fixed;bottom:80px;right:28px;width:420px;max-width:calc(100vw - 32px);max-height:50vh;overflow:auto;background:#fff;border:1px solid #c5d7e5;border-radius:10px;padding:25px;box-shadow:0 10px 60px #00335926;z-index:5}.notes-panel h2{font-size:14px;margin:0 0 13px;color:var(--blue)}.notes-panel p{font-size:15px;line-height:1.8}.notes-title{display:flex;justify-content:space-between;align-items:center}.notes-title button{border:0;background:none;font-size:20px;color:var(--muted)}dialog{border:1px solid #d4e0e9;border-radius:12px;padding:26px;color:var(--ink);max-width:calc(100vw - 40px);max-height:calc(100dvh - 40px);box-shadow:0 20px 100px #00152b40}dialog::backdrop{background:#09253bcc;backdrop-filter:blur(5px)}.dialog-header{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:23px}.dialog-header h2{font-size:22px}.dialog-close{border:1px solid var(--line);background:white;min-width:32px;height:32px;border-radius:5px;font-size:22px}#overview{width:1000px}.overview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.overview-item{padding:16px;text-align:left;background:var(--bg-soft);border:1px solid transparent;border-radius:5px;display:flex;gap:13px;min-height:86px;align-items:flex-start}.overview-item:hover{border-color:#9ec3df}.overview-item.current{border-color:var(--blue);background:var(--pale)}.overview-item .number{font-size:17px;font-weight:bold;color:var(--blue);min-width:27px}.overview-item .overview-text{font-size:13px;line-height:1.4;font-weight:600}.overview-item small{font-size:9px;letter-spacing:.6px;color:#6e8699;display:block;margin-bottom:6px;text-transform:uppercase}.overview-section{grid-column:1/-1;font-size:11px;letter-spacing:1px;color:var(--muted);margin:12px 0 3px}#figure-dialog{width:min(1400px,96vw);padding:22px}#figure-dialog img{display:block;width:100%;max-height:calc(100dvh - 180px);object-fit:contain;background:white}#figure-dialog .dialog-header{margin-bottom:15px}#figure-title{font-size:16px}#figure-source{display:inline-block;font-size:13px;color:var(--blue);margin-top:16px}#help-dialog{width:450px}#help-dialog dl{display:grid;grid-template-columns:140px 1fr;gap:15px;font-size:14px}#help-dialog dt{font-family:monospace;color:var(--blue)}#help-dialog dd{margin:0;color:var(--muted)}body:fullscreen .app-header,body:fullscreen .app-footer{display:none}body:fullscreen .viewport{height:100dvh;padding:0;background:#0c1c29}body:fullscreen .stage{box-shadow:none}.toast{position:fixed;top:75px;left:50%;transform:translateX(-50%);background:var(--navy);color:white;font-size:13px;padding:12px 18px;border-radius:5px;z-index:20}
@media (max-width:1050px){.app-subtitle,.duration{display:none}.chapters{gap:13px}.chapter-button{font-size:10px}.app-header,.app-footer{padding-left:18px;padding-right:18px}.tool-label{display:none}}
@media (max-width:680px){.app-header{height:54px;padding:0 12px;gap:10px}.app-brand{font-size:11px;gap:8px}.app-tools{gap:5px}.app-logo{width:24px;height:28px}.tool-button{min-width:31px;padding:6px}.tool-print{display:none}.viewport{height:calc(100dvh - 112px);padding:10px}.app-footer{height:58px;padding:0 12px}.chapters{overflow-x:auto;flex:1;gap:15px;scrollbar-width:none}.chapter-button{font-size:10px}.nav-controls{gap:6px}.nav-arrow{width:29px;height:29px}.page-count{min-width:50px}.overview-grid{grid-template-columns:1fr 1fr}dialog{padding:16px;max-width:calc(100vw - 20px)}.overview-item{padding:10px;gap:8px}.overview-item .overview-text{font-size:12px}.overview-item small{font-size:8px}.dialog-header h2{font-size:18px}.notes-panel{right:16px;bottom:70px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;scroll-behavior:auto!important}}
@page{size:1440px 810px;margin:0}
@media print{html,body{margin:0!important;padding:0!important;background:white!important}.app-header,.app-footer,.global-progress,.notes-panel,dialog,.toast,.sr-only{display:none!important}.viewport{height:auto!important;padding:0!important;display:block!important;overflow:visible!important}.stage-wrap,.stage{width:1440px!important;height:auto!important;transform:none!important;box-shadow:none!important}.slide{display:flex!important;break-after:page;page-break-after:always;print-color-adjust:exact;-webkit-print-color-adjust:exact}.slide[data-backup]{display:none!important}.slide:nth-child(18){break-after:auto;page-break-after:auto}.zoom-hint,.text-button{display:none!important}.figure-zoom{border:0!important}a{text-decoration:none!important}}

/* Research defense: original architecture, observed cases, mechanisms, and study controls. */
.arc-layout { display:grid; grid-template-columns:minmax(0,1fr) 460px; gap:48px; align-items:center; }
.architecture-visual { display:flex; flex-direction:column; align-items:flex-start; gap:18px; }
.arc-layout .architecture-original { justify-self:start; width:min(100%,585px); }
.architecture-original img { max-height:390px; }
.architecture-original figcaption { font-size:12px; }
.architecture-reading { border-left:2px solid var(--blue); padding-left:30px; align-self:stretch; display:flex; align-items:center; margin-left:-12px; }
.architecture-intro p { font-size:23px; line-height:1.3; color:var(--ink); letter-spacing:-.35px; max-width:650px; margin:0; }
.architecture-cards { display:grid; grid-template-columns:1fr; gap:22px; width:100%; }
.architecture-card { background:#fff3c4; border-left:5px solid #e8b923; padding:27px 27px 25px; border-radius:10px; color:#5c4a06; font-size:25px; line-height:1.28; font-weight:700; box-shadow:0 6px 20px rgba(0,21,43,.08); margin-left:-12px; }
.architecture-card span { display:block; font-size:13px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#8a6b00; margin-bottom:11px; }
.gap-detail { font-size:17px; margin-top:16px; }
.method .model-detail { font-size:14px; color:var(--blue); margin:0 0 10px; }
.case-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.case-grid article { background:var(--bg-soft); border-top:3px solid var(--accent-mid); padding:23px 24px; }
.case-grid article:last-child { border-color:var(--orange); }
.case-grid .label { font-size:10px; letter-spacing:1px; margin-bottom:16px; }
.case-grid h2 { font-size:29px; margin-bottom:17px; }
.case-grid p { font-size:17px; line-height:1.4; }
.case-grid .case-failure { color:var(--ink); font-weight:700; min-height:49px; margin-bottom:12px; }
.case-evidence { margin:17px 0 12px; padding:13px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.case-evidence span { display:block; font-size:9px; color:var(--muted); letter-spacing:.45px; margin-bottom:9px; }
.case-evidence code { font-size:17px; font-weight:700; color:var(--blue); overflow-wrap:anywhere; }
.case-grid .case-lesson { color:var(--blue); font-size:16px; }
.trajectory-slide .slide-body{display:flex;align-items:stretch;justify-content:center;padding-top:8px}
.trajectory{display:flex;align-items:stretch;gap:0;width:100%}
.traj-step{flex:1;background:var(--card-bg);border-top:4px solid var(--card-border);padding:22px 20px;display:flex;flex-direction:column;gap:10px;min-height:220px}
.traj-num{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;font-weight:700;font-size:15px;flex:none}
.traj-step h3{font-size:16px;margin:0;color:var(--ink);line-height:1.25}
.traj-step p{font-size:13.5px;color:var(--muted);margin:0;line-height:1.5}
.traj-step p code{font-size:12.5px;font-weight:700;color:var(--ink);background:var(--code-bg);padding:1px 5px;border-radius:3px}
.traj-arrow{display:flex;align-items:center;justify-content:center;padding:0 8px;font-size:24px;color:var(--accent-mid);flex:none}
.traj-step.traj-miss{background:var(--orange-bg);border-top-color:var(--orange)}
.traj-step.traj-miss .traj-num{background:var(--orange)}
.traj-step.traj-miss h3{color:var(--orange)}
.traj-step.traj-miss code{background:var(--orange-code-bg)}
.pattern-intro .slide-body{display:flex;align-items:center;justify-content:center}
.pattern-card{text-align:center;max-width:660px;margin:0 auto}
.pattern-eyebrow{display:inline-block;font-size:11px;letter-spacing:2px;color:var(--blue);font-weight:700;margin-bottom:16px;text-transform:uppercase}
.pattern-title{font-size:54px;line-height:1.08;color:var(--ink);margin:0 0 20px;letter-spacing:-.5px}
.pattern-title span{color:var(--orange)}
.pattern-desc{font-size:20px;color:var(--ink);line-height:1.55;margin:0 auto 24px;max-width:560px}
.pattern-count{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.5px;color:var(--navy);background:var(--pale);padding:9px 20px;border-radius:20px}


.case-comparison { display:grid; grid-template-columns:1fr 1.3fr 1.05fr; gap:18px; }
.case-comparison > div { padding:20px; background:var(--bg-soft-2); }
.case-comparison .comparison-context { background:transparent; padding-left:0; }
.comparison-context strong { display:block; font-size:21px; line-height:1.35; margin:16px 0; }
.comparison-context code { font-size:15px; color:var(--muted); }
.case-comparison .guided-path { background:var(--pale); border-left:3px solid var(--blue); }
.case-comparison h2 { font-size:24px; margin:15px 0 12px; }
.case-comparison p { font-size:16px; line-height:1.7; min-height:54px; }
.case-comparison .label { font-size:10px; }
.case-outcome { display:block; font-size:15px; font-weight:700; color:var(--blue); margin-top:12px; }
.guidance-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:2px; }
.guidance-cards article { border-top:1px solid var(--line); padding-top:20px; }
.guidance-cards .label { font-size:10px; }
.guidance-cards h2 { font-size:24px; margin:12px 0 10px; }
.guidance-cards p { font-size:18px; }
.framework-operational img { max-height:300px; }
.operating-rules { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; border-top:1px solid var(--line); padding-top:17px; }
.operating-rules .label { font-size:11px; margin-bottom:10px; }
.operating-rules p { font-size:18px; }
.operating-rules code { color:var(--blue); font-size:16px; }
.defense-closing > * { min-width:0; }
.defense-closing { display:grid; grid-template-columns:1.05fr 1fr; gap:72px; }
.conclusion-evidence > .label { margin-bottom:19px; }
.closing-result { display:flex; align-items:center; gap:27px; padding:19px 0; border-top:1px solid var(--line); }
.closing-result > strong { color:var(--blue); font-size:48px; letter-spacing:-2px; min-width:179px; }
.closing-result small { font-size:21px; letter-spacing:0; }
.closing-result p { font-size:18px; line-height:1.5; }
.closing-result b { font-size:16px; font-weight:500; color:var(--ink); }
.closing-signature { display:flex; justify-content:space-between; align-items:center; border-top:2px solid var(--blue); padding-top:21px; }
.closing-signature > span { font-size:22px; font-weight:700; color:var(--blue); }
.closing-signature .text-button { margin:0; font-size:14px; }
.defense-limits > .label { font-size:10px; letter-spacing:1px; }
.defense-limits strong { font-size:21px; }
.defense-limits p { font-size:17px; }
.defense-limits .next-study { color:var(--blue); margin-top:15px; font-size:17px; }
.control-table img { max-height:315px; }
.protocol-notes { display:grid; grid-template-columns:1fr 1fr; gap:45px; padding-top:15px; border-top:1px solid var(--line); }
.protocol-notes .label { font-size:11px; margin-bottom:9px; }
.protocol-notes p { font-size:18px; }
.notes-panel { width:500px; max-height:65vh; }
.notes-panel p { white-space:pre-line; }

/* Final professor-facing polish: stronger evidence hierarchy and quieter chrome. */
.title-slide .title-prelude{font-size:27px;letter-spacing:.2px;color:var(--blue);font-weight:600}
.title-slide .title-main{font-size:70px;line-height:1.03}
.title-slide .title-visual{box-shadow:18px 18px 0 #dceaf4}
.slide-heading h1{max-width:1180px}
.slide:not(.title-slide)::after{content:'';position:absolute;left:64px;top:96px;width:34px;height:2px;background:var(--blue);opacity:.8}
.evidence-bar{display:flex;gap:0;border:1px solid var(--line);background:#f8fafc;margin-top:12px;min-height:43px;align-items:center}
.evidence-bar span{padding:0 20px;border-right:1px solid var(--line);font-size:13px;color:var(--muted);line-height:1.2}
.evidence-bar span:last-child{border-right:0;margin-left:auto;color:var(--blue);font-style:italic}
.evidence-bar b{font-size:19px;color:var(--blue);margin-right:5px}
.architecture-claim b{color:var(--ink)}
.closing-signature>span{font-size:19px;letter-spacing:.1px}

/* Keep slide 9 footnote from colliding with takeaway. */
#s9 .footnote { display: none; }

.deployment-figure img{width:100%;max-height:255px;object-fit:contain}.deployment-figure figcaption{margin-top:10px}.deployment-phases{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.deployment-phases>div{border-top:2px solid var(--blue);padding-top:13px}.deployment-phases span{font-size:12px;color:var(--blue);font-weight:700;letter-spacing:1px}.deployment-phases h2{margin:8px 0 7px;font-size:22px}.deployment-phases p{font-size:16px;line-height:1.35}.deployment-slide .takeaway{margin-top:8px}.deployment-slide .slide-body{gap:16px}.agenda-list{display:flex;flex-direction:column;gap:0;max-width:1040px;margin:0 auto;width:100%}.agenda-list article{display:grid;grid-template-columns:90px 1fr;gap:25px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}.agenda-list article>span{font-size:38px;font-weight:700;color:var(--accent-mid)}.agenda-list h2{font-size:29px;margin-bottom:4px}.agenda-list p{font-size:19px}
.highlight-callout{background:#fff3c4;border-left:4px solid #e8b923;padding:14px 20px;font-size:19px;font-weight:600;color:#5c4a06;margin-top:6px}
.contract-strip{display:flex;align-items:center;gap:18px;font-size:18px;color:var(--muted);padding:12px 0;border-bottom:1px solid var(--line);margin-bottom:4px}.contract-strip b{color:var(--blue)}.contract-strip span:nth-child(2){color:var(--accent-mid);font-size:22px}

/* FL method landscape (background): five families narrowed to two feasible ones. */
.fl-landscape{display:flex;flex-direction:column;gap:18px;justify-content:center;height:100%}
.fl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.challenge-lead{font-size:20px;color:var(--ink);max-width:1100px;margin:0 0 4px}.challenge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;flex:1;align-items:stretch}
.step-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.fl-card{background:var(--card-bg);border-top:3px solid var(--card-border);padding:16px 16px 14px;display:flex;flex-direction:column;min-height:0}
#s4-fl .fl-card p{font-size:19px;line-height:1.45}.challenge-grid .fl-card p{font-size:15px;line-height:1.38}#s3-fl-challenge .slide-body{justify-content:flex-start;gap:12px}#s3-fl-challenge .takeaway{margin-top:4px;min-height:50px}#s3-fl-challenge .takeaway p{font-size:16px;line-height:1.35}
.why-hard-grid{display:grid;grid-template-rows:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch;flex:1}.why-hard-row{display:grid;grid-template-columns:240px minmax(0,1fr);gap:28px;align-items:center;background:var(--card-bg);border-left:5px solid #b7ccdc;border-radius:12px;padding:22px 26px}.why-hard-row .label,.ollama-stat-card .label,.ollama-card .label{font-size:11px;letter-spacing:1.4px;color:var(--blue);font-weight:700}.why-hard-stat{display:flex;flex-direction:column;gap:8px;justify-content:center}.why-hard-stat strong{display:block;font-size:54px;line-height:.92;color:var(--blue);letter-spacing:-2px}.why-hard-stat span{display:block;font-size:16px;line-height:1.35;color:var(--muted);font-weight:600}.why-hard-copy h2,.ollama-card h2{font-size:27px;margin:0 0 8px;letter-spacing:-.4px}.why-hard-copy p,.ollama-card p{font-size:18px;line-height:1.42;margin:0;color:var(--ink)}.ollama-grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:20px;align-items:stretch;flex:1}.ollama-stat-card{display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(180deg,#eef5fb 0%,#fff 100%);border-top-color:var(--blue)}.ollama-stat-card .fl-stat{font-size:72px;line-height:.95;margin:12px 0 10px}.ollama-stat-card .fl-stat small{display:block;font-size:18px;color:var(--muted);font-weight:500;letter-spacing:0;margin-top:8px}.ollama-stat-card p{font-size:17px;line-height:1.45;margin:0;color:var(--ink)}.ollama-right{display:grid;grid-template-rows:1fr 1fr;gap:20px}.ollama-card{display:flex;flex-direction:column;gap:12px}.ollama-list{display:flex;flex-wrap:wrap;gap:8px 10px;margin-top:2px}.ollama-list span{display:inline-block;background:var(--pale);color:var(--navy);padding:7px 10px;border-radius:999px;font-size:14px;font-weight:600;line-height:1.25}.ollama-card p strong{color:var(--blue)}
.fl-card .label{font-size:10px;letter-spacing:1.1px}
.fl-card h2{font-size:26px;margin:11px 0 9px;letter-spacing:-.3px}
.fl-card h2 span{display:block;font-size:16px;font-weight:400;color:var(--muted);margin-top:3px;letter-spacing:0}
.fl-card p{font-size:18px;line-height:1.45;color:var(--ink)}
#s8b .trajectory{flex-direction:column;gap:16px}#s8b .traj-arrow{display:none}#s8b .traj-step h3{font-size:22px;margin-top:6px}#s8b .traj-step p{font-size:16px}#s8d .step-grid-linked{grid-template-columns:1fr 44px 1fr;align-items:center}
#s8d .step-grid-linked .traj-arrow{font-size:26px}
#s8d .fl-card{padding:26px 28px 24px}
#s8d .fl-card h2{font-size:24px;line-height:1.25;margin:12px 0 10px}
#s8d .fl-card p{font-size:16.5px;line-height:1.55}
#s8d .formula-badge{display:inline-block;margin-left:10px;padding:3px 10px;border-radius:6px;background:var(--pale);color:var(--blue);font-size:15px;font-weight:700;letter-spacing:.2px;vertical-align:middle}
.fl-stat{font-size:44px;font-weight:700;color:var(--blue);line-height:1;margin:14px 0 12px;letter-spacing:-1.5px}.fl-stat span{display:block;font-size:13px;font-weight:400;color:var(--muted);letter-spacing:0;margin-top:6px}.fl-card .fl-stat{font-size:33px;font-weight:700;color:var(--blue);letter-spacing:-1px;margin:8px 0 7px;line-height:1.1}.fl-card .fl-stat small{display:block;font-size:13.5px;font-weight:400;color:var(--muted);letter-spacing:0;margin-top:3px}
.fl-card .fl-sub{margin-top:11px;padding-top:11px;border-top:1px solid var(--line)}
.fl-card .fl-sub:first-of-type{margin-top:0;padding-top:0;border-top:0}
.fl-card .fl-sub strong{display:block;font-size:17px;color:var(--ink);margin-bottom:3px}
.fl-card .fl-cite{display:block;font-size:13px;color:var(--muted);font-style:italic;margin-top:10px;line-height:1.45}.fl-cite a{color:inherit;text-decoration:underline;text-decoration-color:#9eb4c5;text-underline-offset:2px}.fl-cite a:hover{color:var(--blue);text-decoration-color:currentColor}.footnote-cite{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.footnote-cite a{color:inherit}.footnote-cite a:hover{color:var(--blue)}.cite-num{font-size:10px;font-weight:700;vertical-align:super;line-height:0;margin-left:2px;color:var(--blue);text-decoration:none}.cite-num:hover{text-decoration:underline}
.fl-card .fl-verdict{margin-top:auto;padding-top:13px;border-top:1px solid var(--line);display:flex;align-items:center;gap:9px;font-size:15px;font-weight:700;line-height:1.3}
.fl-card .fl-mark{font-size:17px;flex-shrink:0}
.fl-card.kept{background:var(--pale);border-color:var(--card-border-kept)}
.fl-card.kept .fl-verdict{color:var(--blue)}
.fl-card.excluded .fl-verdict{color:var(--orange)}
.fl-card.excluded{border-color:var(--card-border-excluded)}

/* Section dividers ("Part N") and outline checkpoint slides. */
.section-divider .slide-body{display:flex;align-items:center}
.divider-copy{max-width:660px}
